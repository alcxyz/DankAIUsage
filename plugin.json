{
  "id": "dankAIUsage",
  "name": "AI Usage",
  "description": "Monitor Codex and Claude quotas, credits, and token history",
    "version": "2.1.1",
  "author": "alcxyz",
  "icon": "monitoring",
  "type": "widget",
  "capabilities": ["dankbar-widget"],
  "component": "./DankAIUsageWidget.qml",
  "settings": "./DankAIUsageSettings.qml",
  "settings_schema": {
    "publicResetAnnouncements": {
      "type": "boolean",
      "default": false
    },
    "systemNotifications": {
      "type": "boolean",
      "default": true
    },
    "showUsed": {
      "type": "boolean",
      "default": false
    },
    "refreshInterval": {
      "type": "integer",
      "default": 300,
      "minimum": 180,
      "maximum": 3600
    },
    "refreshOnOpen": {
      "type": "boolean",
      "default": false
    },
    "showCodex": {
      "type": "boolean",
      "default": true
    },
    "showClaude": {
      "type": "boolean",
      "default": true
    },
    "providerOrder": {
      "type": "string",
      "enum": ["codex", "claude"],
      "default": "codex"
    },
    "barShowPluginIcon": {
      "type": "boolean",
      "default": false
    },
    "barShowProviderLogos": {
      "type": "boolean",
      "default": true
    },
    "barShowClaudeSession": {
      "type": "boolean",
      "default": true
    },
    "barShowClaudeWeekly": {
      "type": "boolean",
      "default": true
    },
    "barClaudeWeeklyOverrides": {
      "type": "object",
      "default": {}
    },
    "barShowClaudeCredits": {
      "type": "boolean",
      "default": false
    },
    "barShowCodexCredits": {
      "type": "boolean",
      "default": false
    },
    "claudePrimeEnabled": {
      "type": "boolean",
      "default": false
    },
    "claudePrimeActiveFrom": {
      "type": "integer",
      "default": 7,
      "minimum": 0,
      "maximum": 23
    },
    "claudePrimeActiveUntil": {
      "type": "integer",
      "default": 23,
      "minimum": 0,
      "maximum": 24
    },
    "claudePrimeMinWeeklyLeft": {
      "type": "integer",
      "default": 10,
      "minimum": 0,
      "maximum": 50
    },
    "claudePrimeDailyCap": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "maximum": 10
    },
    "includeCachedTokens": {
      "type": "boolean",
      "default": false
    },
    "compactPill": {
      "type": "boolean",
      "default": false
    },
    "barQuotaBars": {
      "type": "boolean",
      "default": false
    },
    "barQuotaBarWidth": {
      "type": "integer",
      "default": 40,
      "minimum": 16,
      "maximum": 120
    },
    "barLabelLeft": {
      "type": "string",
      "enum": ["none", "tag", "time", "percent"],
      "default": "none"
    },
    "barLabelRight": {
      "type": "string",
      "enum": ["none", "tag", "time", "percent"],
      "default": "none"
    },
    "barPaceMarker": {
      "type": "boolean",
      "default": false
    },
    "brandLogoColors": {
      "type": "boolean",
      "default": false
    },
    "barUsageColors": {
      "type": "boolean",
      "default": false
    },
    "heatmapPalette": {
      "type": "string",
      "enum": ["fixed", "theme"],
      "default": "fixed"
    },
    "heatmapBasis": {
      "type": "string",
      "enum": ["usage", "pace"],
      "default": "usage"
    }
  },
  "permissions": ["settings_read", "settings_write", "process"],
  "requires": ["dankaiusage", "codex", "claude"]
}
