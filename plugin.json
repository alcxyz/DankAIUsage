{
  "id": "dankAIUsage",
  "name": "AI Usage",
  "description": "Monitor Codex and Claude quotas, credits, and token history",
  "version": "0.6.0",
  "author": "alcxyz",
  "icon": "monitoring",
  "type": "widget",
  "capabilities": ["dankbar-widget"],
  "component": "./DankAIUsageWidget.qml",
  "settings": "./DankAIUsageSettings.qml",
  "settings_schema": {
    "showUsed": {
      "type": "boolean",
      "default": false
    },
    "refreshInterval": {
      "type": "integer",
      "default": 300,
      "minimum": 30,
      "maximum": 1800
    },
    "periodDays": {
      "type": "integer",
      "default": 7,
      "minimum": 1,
      "maximum": 90
    },
    "showCodex": {
      "type": "boolean",
      "default": true
    },
    "showClaude": {
      "type": "boolean",
      "default": true
    },
    "barShowPluginIcon": {
      "type": "boolean",
      "default": false
    },
    "barShowProviderLogos": {
      "type": "boolean",
      "default": true
    },
    "barShowClaudeSession": {
      "type": "boolean",
      "default": true
    },
    "barShowClaudeWeekly": {
      "type": "boolean",
      "default": true
    },
    "barShowClaudeCredits": {
      "type": "boolean",
      "default": false
    },
    "enableClaudePrime": {
      "type": "boolean",
      "default": false
    },
    "includeCachedTokens": {
      "type": "boolean",
      "default": false
    },
    "compactPill": {
      "type": "boolean",
      "default": false
    }
  },
  "permissions": ["settings_read", "settings_write", "process"],
  "requires": ["dankaiusage", "codex", "claude"]
}
